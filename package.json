{
  "name": "opentj",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && node scripts/verify-build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:api": "node scripts/verify-api.mjs",
    "test:uploads": "node scripts/verify-uploads.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "db:local": "node scripts/local-db.mjs",
    "worker": "tsx src/worker.ts",
    "worker:once": "tsx src/worker.ts --once",
    "check:env": "node --env-file=.env scripts/check-env.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
    "@fullcalendar/core": "7.0.2",
    "@fullcalendar/daygrid": "6.1.21",
    "@fullcalendar/interaction": "6.1.21",
    "@fullcalendar/list": "6.1.21",
    "@fullcalendar/luxon3": "6.1.21",
    "@fullcalendar/react": "7.0.2",
    "@fullcalendar/timegrid": "6.1.21",
    "@prisma/client": "7.10.0",
    "file-type": "22.0.2",
    "katex": "0.18.5",
    "lucide-react": "1.41.0",
    "luxon": "3.7.2",
    "next": "16.3.4",
    "oauth4webapi": "3.8.7",
    "pdf-lib": "1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "rehype-sanitize": "6.0.0",
    "remark-math": "6.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/katex": "0.16.8",
    "@types/luxon": "3.7.1",
    "@types/node": "22.9.4",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitest/coverage-v8": "4.1.11",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "27.0.0",
    "prisma": "6.12.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "vite": "6.4.3"
  },
  "overrides": {
    "rollup": "4.62.2",
    "typescript-eslint": "8.55.0",
    "@napi-rs/wasm-runtime": "1.1.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "@prisma/client@6.12.0": true,
    "@prisma/engines@6.12.0": true,
    "esbuild@0.28.2": true,
    "prisma@6.12.0": true,
    "unrs-resolver@1.12.2": true
  }
}
