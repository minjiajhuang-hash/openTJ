NODE_ENV=development
APP_ENV=local
APP_URL=http://127.0.0.1:3000
DATABASE_URL=postgresql://opentj:opentj@localhost:5432/opentj?schema=public
POSTGRES_DB=opentj
POSTGRES_USER=opentj
POSTGRES_PASSWORD=opentj
SESSION_SECRET=replace-with-at-least-32-random-characters
ION_CLIENT_ID=
ION_CLIENT_SECRET=
ION_REDIRECT_URI=http://127.0.0.1:3000/api/v1/auth/ion/callback
ION_AUTHORIZE_URL=https://ion.tjhsst.edu/oauth/authorize/
ION_TOKEN_URL=https://ion.tjhsst.edu/oauth/token/
ION_PROFILE_URL=https://ion.tjhsst.edu/api/profile
ION_REVOKE_URL=https://ion.tjhsst.edu/oauth/revoke_token/
BOOTSTRAP_ADMIN_ION_IDS=
DEMO_AUTH_ENABLED=true
COURSE_JOIN_CODE=concrete-p4-demo
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=opentj-private
S3_ACCESS_KEY=opentj
S3_SECRET_KEY=replace-this-minio-secret
S3_FORCE_PATH_STYLE=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
PDF_MAX_BYTES=20971520
PDF_MAX_PAGES=200
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=uploads
# Optional native scanner for local Windows development (setup-clamav.ps1 fills these).
CLAMAV_COMMAND=
CLAMAV_DATABASE=
# Enable only behind a proxy that overwrites incoming forwarding headers.
TRUST_PROXY=false
PRESERVATION_HOLD=false
